---
import { site, kitchenHours } from '../data/site';
// Computed at build time. Their live footer is frozen at 2018.
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div>
        <h4>Hoffstot&rsquo;s Cafe Monaco</h4>
        <p>{site.tagline}.</p>
        <p><a href={site.orderUrl} target="_blank" rel="noopener">Order online</a></p>
      </div>
      <div>
        <h4>Find us</h4>
        <p>
          <a href={site.mapsUrl} target="_blank" rel="noopener">
            {site.address.street}<br />
            {site.address.city}, {site.address.state} {site.address.zip}
          </a>
        </p>
      </div>
      <div>
        <h4>Contact</h4>
        <p><a href={site.phoneHref}>{site.phone}</a> {site.phoneNote}</p>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <div>
        <h4>Kitchen</h4>
        {kitchenHours.map((h) => (
          <p style="margin:0">{h.day} &nbsp;{h.open} &ndash; {h.close}</p>
        ))}
        <p style="margin:.4rem 0 0">The bar stays open later.</p>
      </div>
    </div>
    <div class="footer__bottom">
      <span>&copy; {year} Hoffstot&rsquo;s Cafe Monaco. All rights reserved.</span>
      <span>Oakmont, Pennsylvania</span>
    </div>
  </div>
</footer>
